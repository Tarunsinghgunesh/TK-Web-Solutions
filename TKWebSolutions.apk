<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#050b18">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>TK Web Solutions App</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
:root{
  --blue:#1a56ff; --blue2:#0d3acc; --bluel:rgba(26,86,255,.12);
  --navy:#050b18; --navy2:#0a1428;
  --green:#25d366; --accent:#00e5ff; --gold:#f59e0b;
  --white:#fff; --gray:#64748b;
  --glass:rgba(255,255,255,.04); --gborder:rgba(255,255,255,.08);
  --red:#ef4444; --purple:#7c3aed;
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;overflow-x:hidden;}
body{font-family:'DM Sans',sans-serif;background:var(--navy);color:var(--white);}
a{text-decoration:none;color:inherit;}
input,select,textarea,button{font-family:'DM Sans',sans-serif;}
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(26,86,255,.025) 1px,transparent 1px),linear-gradient(90deg,rgba(26,86,255,.025) 1px,transparent 1px);background-size:44px 44px;}
/* NAV */
.app-nav{position:sticky;top:0;z-index:300;background:rgba(5,11,24,.97);backdrop-filter:blur(24px);border-bottom:1px solid rgba(26,86,255,.15);padding:13px 5%;display:flex;align-items:center;justify-content:space-between;}
.app-logo{display:flex;align-items:center;gap:9px;}
.logo-mark{width:34px;height:34px;border-radius:9px;background:var(--blue);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:900;font-size:.88rem;box-shadow:0 4px 16px rgba(26,86,255,.45);}
.logo-text{font-family:'Syne',sans-serif;font-weight:800;font-size:1rem;line-height:1;}
.logo-text small{display:block;font-size:.5rem;color:var(--accent);letter-spacing:1.5px;font-weight:600;margin-top:2px;}
.nav-actions{display:flex;gap:8px;align-items:center;}
.nav-call{width:34px;height:34px;background:var(--blue);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.82rem;box-shadow:0 4px 14px rgba(26,86,255,.4);}
.nav-owner{width:34px;height:34px;background:rgba(124,58,237,.2);border:1px solid rgba(124,58,237,.4);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.82rem;color:#a78bfa;cursor:pointer;}
/* PAGES */
.page{display:none;min-height:calc(100vh - 56px);position:relative;z-index:1;}
.page.active{display:block;animation:pgIn .28s ease;}
@keyframes pgIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
/* HERO */
.hero{padding:36px 5% 28px;position:relative;overflow:hidden;}
.hero-orbs{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
.orb1{position:absolute;top:-80px;right:-60px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(26,86,255,.28),transparent 70%);animation:oF 6s ease-in-out infinite;}
.orb2{position:absolute;bottom:-60px;left:-40px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(0,229,255,.12),transparent 70%);animation:oF 8s ease-in-out infinite reverse;}
@keyframes oF{0%,100%{transform:translateY(0);}50%{transform:translateY(-18px);}}
.hero-content{position:relative;z-index:1;}
.hero-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(26,86,255,.18);border:1px solid rgba(26,86,255,.4);color:var(--accent);padding:5px 14px;border-radius:30px;font-size:.68rem;font-weight:700;letter-spacing:.5px;margin-bottom:16px;}
.pdot{width:6px;height:6px;background:var(--accent);border-radius:50%;animation:pd 1.5s infinite;flex-shrink:0;}
@keyframes pd{0%,100%{transform:scale(1);opacity:1;}50%{transform:scale(1.8);opacity:.3;}}
.hero h1{font-family:'Syne',sans-serif;font-size:clamp(1.55rem,6vw,2rem);font-weight:900;line-height:1.2;margin-bottom:11px;letter-spacing:-.5px;}
.hero h1 .ac{background:linear-gradient(90deg,var(--blue),var(--accent));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-sub{color:rgba(255,255,255,.48);font-size:.86rem;line-height:1.7;margin-bottom:22px;}
.hero-btns{display:flex;gap:10px;}
.btn-wa{flex:1;display:flex;align-items:center;justify-content:center;gap:8px;background:var(--green);color:#fff;padding:12px 14px;border-radius:12px;font-weight:700;font-size:.86rem;box-shadow:0 6px 20px rgba(37,211,102,.3);}
.btn-call{display:flex;align-items:center;justify-content:center;gap:7px;background:var(--bluel);border:1.5px solid rgba(26,86,255,.35);color:#fff;padding:12px 16px;border-radius:12px;font-weight:700;font-size:.86rem;white-space:nowrap;}
.stats-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(255,255,255,.06);border-radius:14px;overflow:hidden;margin-top:20px;border:1px solid rgba(255,255,255,.07);}
.stat-cell{background:rgba(255,255,255,.03);padding:13px 10px;text-align:center;}
.stat-num{font-family:'Syne',sans-serif;font-size:1.3rem;font-weight:900;background:linear-gradient(135deg,#fff,rgba(255,255,255,.7));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.stat-num em{-webkit-text-fill-color:var(--accent);font-style:normal;}
.stat-lbl{font-size:.58rem;color:rgba(255,255,255,.3);text-transform:uppercase;letter-spacing:.5px;margin-top:2px;}
/* COMMON */
.section{padding:24px 5%;}
.sec-tag{display:inline-flex;align-items:center;gap:6px;background:rgba(26,86,255,.1);border:1px solid rgba(26,86,255,.2);color:var(--blue);font-size:.61rem;font-weight:700;padding:4px 12px;border-radius:20px;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;}
.sec-tag::before{content:'';width:5px;height:5px;background:var(--blue);border-radius:50%;}
.sec-h{font-family:'Syne',sans-serif;font-size:1.3rem;font-weight:800;margin-bottom:5px;line-height:1.25;}
.sec-h span{color:var(--blue);}
.sec-sub{color:var(--gray);font-size:.83rem;line-height:1.65;margin-bottom:18px;}
.divider{height:1px;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07),transparent);margin:0 5%;}
.cta-btn{display:flex;align-items:center;justify-content:center;gap:9px;padding:14px;border-radius:12px;font-weight:700;font-size:.9rem;margin-top:16px;border:none;cursor:pointer;width:100%;}
.cta-btn.wa{background:var(--green);color:#fff;box-shadow:0 6px 20px rgba(37,211,102,.3);}
.cta-btn.blue{background:var(--blue);color:#fff;box-shadow:0 6px 20px rgba(26,86,255,.35);}
/* SERVICES */
.svc-grid{display:flex;flex-direction:column;gap:9px;}
.svc-card{background:var(--glass);border:1px solid var(--gborder);border-radius:13px;padding:14px 15px;display:flex;align-items:center;gap:13px;position:relative;overflow:hidden;}
.svc-card:active{transform:scale(.98);background:rgba(26,86,255,.08);}
.svc-ico{width:42px;height:42px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0;}
.svc-info{flex:1;min-width:0;}
.svc-info h3{font-family:'Syne',sans-serif;font-size:.87rem;font-weight:700;margin-bottom:2px;}
.svc-info p{font-size:.72rem;color:var(--gray);line-height:1.4;}
.svc-price{font-family:'Syne',sans-serif;font-size:.8rem;font-weight:800;color:var(--gold);white-space:nowrap;flex-shrink:0;}
.svc-card.app-card{border-color:rgba(76,175,80,.2);background:rgba(76,175,80,.04);}
.svc-card.app-card .svc-price{color:#4CAF50;}
.sep-label{font-family:'Syne',sans-serif;font-size:.7rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:9px;padding-left:2px;}
.included-box{background:rgba(26,86,255,.07);border:1px solid rgba(26,86,255,.18);border-radius:14px;padding:16px;margin-top:16px;}
.ib-title{font-family:'Syne',sans-serif;font-weight:700;font-size:.85rem;margin-bottom:11px;}
.ib-tags{display:flex;flex-wrap:wrap;gap:6px;}
.ib-tag{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:4px 11px;font-size:.68rem;color:rgba(255,255,255,.6);}
/* PORTFOLIO */
.port-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.port-card{background:var(--glass);border:1px solid var(--gborder);border-radius:14px;padding:16px 12px;text-align:center;}
.port-card:active{transform:scale(.96);}
.port-emoji{font-size:1.8rem;margin-bottom:7px;}
.port-name{font-family:'Syne',sans-serif;font-size:.78rem;font-weight:700;margin-bottom:3px;}
.port-type{font-size:.67rem;color:var(--gray);margin-bottom:9px;}
.port-link{display:inline-block;background:var(--blue);color:#fff;padding:6px 14px;border-radius:8px;font-size:.7rem;font-weight:700;}
/* CONTACT */
.contact-list{display:flex;flex-direction:column;gap:9px;}
.contact-item{display:flex;align-items:center;gap:13px;background:var(--glass);border:1px solid var(--gborder);border-radius:13px;padding:13px;}
.contact-item:active{transform:scale(.98);}
.c-ico{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0;}
.c-info{flex:1;min-width:0;}
.c-label{font-size:.65rem;color:var(--gray);margin-bottom:2px;}
.c-val{font-family:'Syne',sans-serif;font-size:.82rem;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.c-arrow{color:rgba(255,255,255,.18);font-size:.75rem;flex-shrink:0;}
.t-card{background:var(--glass);border:1px solid var(--gborder);border-radius:13px;padding:16px;margin-bottom:9px;}
.t-stars{color:var(--gold);font-size:.82rem;margin-bottom:6px;letter-spacing:1px;}
.t-text{font-size:.8rem;color:rgba(255,255,255,.58);line-height:1.65;margin-bottom:11px;font-style:italic;}
.t-author{display:flex;align-items:center;gap:9px;}
.t-av{width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--accent));display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:.8rem;flex-shrink:0;}
.t-name{font-family:'Syne',sans-serif;font-size:.78rem;font-weight:700;}
.t-role{font-size:.65rem;color:var(--gray);}
.loc-box{background:var(--glass);border:1px solid var(--gborder);border-radius:13px;padding:16px;text-align:center;margin-top:18px;}
/* FOUNDER */
.founder-hero{background:linear-gradient(135deg,var(--navy),#0d1635);padding:28px 5%;position:relative;overflow:hidden;text-align:center;}
.founder-hero::before{content:'';position:absolute;top:-80px;right:-80px;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(124,58,237,.2),transparent 70%);pointer-events:none;}
.founder-photo{width:90px;height:90px;border-radius:22px;background:linear-gradient(135deg,var(--blue),var(--purple));display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 14px;border:3px solid rgba(26,86,255,.4);box-shadow:0 12px 40px rgba(26,86,255,.35);position:relative;}
.founder-online{position:absolute;bottom:4px;right:4px;width:13px;height:13px;background:#22c55e;border-radius:50%;border:2px solid var(--navy);animation:pd 1.5s infinite;}
.founder-name{font-family:'Syne',sans-serif;font-size:1.2rem;font-weight:900;margin-bottom:3px;}
.founder-role{font-size:.72rem;color:var(--accent);letter-spacing:1.5px;font-weight:600;text-transform:uppercase;margin-bottom:14px;}
.founder-badges{display:flex;justify-content:center;gap:7px;flex-wrap:wrap;}
.fb{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:5px 11px;font-size:.63rem;font-weight:600;color:rgba(255,255,255,.6);}
.timeline{position:relative;padding-left:24px;}
.timeline::before{content:'';position:absolute;left:8px;top:6px;bottom:6px;width:2px;background:linear-gradient(180deg,var(--blue),var(--purple),rgba(26,86,255,.1));}
.tl-item{position:relative;margin-bottom:18px;}
.tl-dot{position:absolute;left:-24px;top:4px;width:14px;height:14px;border-radius:50%;background:var(--blue);border:2px solid var(--navy);box-shadow:0 0 10px rgba(26,86,255,.5);}
.tl-year{font-family:'Syne',sans-serif;font-size:.6rem;font-weight:700;color:var(--accent);letter-spacing:1px;margin-bottom:2px;text-transform:uppercase;}
.tl-title{font-family:'Syne',sans-serif;font-size:.88rem;font-weight:700;margin-bottom:3px;}
.tl-body{font-size:.77rem;color:rgba(255,255,255,.5);line-height:1.6;}
.quote-box{background:linear-gradient(135deg,rgba(26,86,255,.12),rgba(124,58,237,.08));border:1px solid rgba(26,86,255,.22);border-radius:14px;padding:18px;margin:16px 0;text-align:center;position:relative;}
.quote-box::before{content:'"';position:absolute;top:-12px;left:14px;font-size:3rem;color:var(--blue);font-family:'Syne',sans-serif;font-weight:900;opacity:.4;line-height:1;}
.quote-text{font-family:'Syne',sans-serif;font-size:.92rem;font-weight:700;color:#fff;line-height:1.5;font-style:italic;}
.quote-sub{font-size:.7rem;color:var(--gray);margin-top:7px;}
/* PAYMENT */
.pay-methods{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-bottom:16px;}
.pay-method{background:var(--glass);border:1px solid var(--gborder);border-radius:12px;padding:14px;text-align:center;cursor:pointer;}
.pay-method.active{background:rgba(26,86,255,.15);border-color:rgba(26,86,255,.5);}
.pay-method:active{transform:scale(.97);}
.pm-icon{font-size:1.5rem;margin-bottom:5px;}
.pm-label{font-family:'Syne',sans-serif;font-size:.76rem;font-weight:700;}
.pm-sub{font-size:.62rem;color:var(--gray);margin-top:2px;}
.qr-box{background:linear-gradient(135deg,rgba(255,255,255,.97),rgba(240,244,255,.95));border-radius:16px;padding:12px;display:inline-block;margin-bottom:12px;box-shadow:0 12px 40px rgba(0,0,0,.5);}
.qr-box img{width:165px;height:165px;display:block;border-radius:6px;}
.upi-id-box{background:rgba(26,86,255,.1);border:1px solid rgba(26,86,255,.25);border-radius:12px;padding:11px 15px;display:flex;align-items:center;justify-content:space-between;margin-bottom:13px;}
.upi-id-label{font-size:.6rem;color:var(--gray);margin-bottom:2px;}
.upi-id-val{font-family:'Syne',sans-serif;font-weight:800;font-size:.88rem;background:linear-gradient(135deg,var(--accent),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.copy-btn{background:rgba(0,229,255,.1);border:1px solid rgba(0,229,255,.25);color:var(--accent);padding:6px 12px;border-radius:8px;font-size:.68rem;font-weight:700;cursor:pointer;}
.app-btns-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:18px;}
.app-pay-btn{display:flex;align-items:center;justify-content:center;gap:7px;padding:11px 8px;border-radius:10px;font-size:.76rem;font-weight:700;color:#fff;border:1px solid;}
.app-pay-btn:active{transform:scale(.97);}
.bank-box{background:rgba(26,86,255,.06);border:1px solid rgba(26,86,255,.15);border-radius:14px;padding:15px;}
.bank-title{font-size:.6rem;color:rgba(255,255,255,.3);letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:12px;text-align:center;}
.bank-row{display:flex;justify-content:space-between;align-items:center;padding:7px 0;}
.bank-row:not(:last-child){border-bottom:1px solid rgba(255,255,255,.05);}
.bank-key{font-size:.68rem;color:rgba(255,255,255,.35);}
.bank-val{font-size:.76rem;font-weight:700;display:flex;align-items:center;gap:6px;}
.mini-copy{background:rgba(0,229,255,.1);border:1px solid rgba(0,229,255,.2);color:var(--accent);padding:2px 7px;border-radius:5px;font-size:.6rem;cursor:pointer;}
.input-group{margin-bottom:12px;}
.input-group label{display:block;font-size:.68rem;color:var(--gray);margin-bottom:6px;font-weight:600;letter-spacing:.3px;}
.input-group input,.input-group select{width:100%;background:rgba(255,255,255,.05);border:1.5px solid rgba(26,86,255,.25);border-radius:10px;padding:11px 13px;color:#fff;font-size:.86rem;outline:none;}
.input-group input:focus,.input-group select:focus{border-color:rgba(26,86,255,.6);}
.input-group select option{background:#0a1428;color:#fff;}
.inp-prefix{background:rgba(255,255,255,.05);border:1.5px solid rgba(26,86,255,.25);border-radius:10px;display:flex;align-items:center;padding:0 13px;}
.inp-prefix span{color:var(--accent);font-weight:900;font-size:1.1rem;margin-right:8px;}
.inp-prefix input{border:none;background:transparent;flex:1;padding:11px 0;color:#fff;font-size:.86rem;outline:none;}
.amt-quick{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-bottom:12px;}
.amt-btn{background:rgba(255,255,255,.04);border:1.5px solid rgba(255,255,255,.08);border-radius:9px;padding:9px 4px;font-size:.76rem;font-weight:700;color:rgba(255,255,255,.6);cursor:pointer;font-family:'DM Sans',sans-serif;}
.amt-btn.selected{background:linear-gradient(135deg,var(--blue),var(--blue2));border-color:var(--blue);color:#fff;box-shadow:0 4px 12px rgba(26,86,255,.35);}
.pay-now-btn{display:flex;align-items:center;justify-content:center;gap:10px;background:linear-gradient(135deg,var(--blue),var(--blue2));color:#fff;padding:14px;border-radius:13px;font-weight:800;font-size:.94rem;font-family:'Syne',sans-serif;width:100%;box-shadow:0 8px 26px rgba(26,86,255,.45);cursor:pointer;border:none;margin-bottom:9px;}
.pay-now-btn:active{transform:scale(.97);}
.notify-btn{display:flex;align-items:center;justify-content:center;gap:8px;background:rgba(37,211,102,.1);border:1.5px solid rgba(37,211,102,.3);color:var(--green);padding:12px;border-radius:11px;font-weight:700;font-size:.84rem;width:100%;cursor:pointer;font-family:'DM Sans',sans-serif;margin-bottom:12px;}
.search-box{background:rgba(255,255,255,.05);border:1.5px solid rgba(26,86,255,.25);border-radius:10px;display:flex;align-items:center;padding:10px 13px;gap:9px;margin-bottom:14px;}
.search-box i{color:var(--gray);font-size:.85rem;}
.search-box input{background:transparent;border:none;color:#fff;font-size:.86rem;flex:1;outline:none;}
.search-btn{background:var(--blue);color:#fff;border:none;padding:7px 13px;border-radius:8px;font-size:.76rem;font-weight:700;cursor:pointer;}
/* MODAL */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:500;display:flex;align-items:flex-end;justify-content:center;backdrop-filter:blur(6px);opacity:0;pointer-events:none;transition:opacity .3s;}
.modal-overlay.open{opacity:1;pointer-events:all;}
.modal-sheet{background:var(--navy2);border-radius:22px 22px 0 0;padding:22px 18px 34px;width:100%;max-width:480px;transform:translateY(100%);transition:transform .35s cubic-bezier(.34,1.56,.64,1);border-top:1px solid rgba(26,86,255,.2);}
.modal-overlay.open .modal-sheet{transform:translateY(0);}
.modal-handle{width:40px;height:4px;background:rgba(255,255,255,.15);border-radius:2px;margin:0 auto 18px;}
.receipt-card{background:linear-gradient(135deg,#0d1635,#0a1a3a);border:1px solid rgba(26,86,255,.25);border-radius:14px;padding:18px;margin-bottom:14px;position:relative;overflow:hidden;}
.receipt-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--blue),var(--accent));}
.receipt-logo{font-family:'Syne',sans-serif;font-weight:900;font-size:1rem;margin-bottom:3px;}
.receipt-logo span{color:var(--blue);}
.receipt-no{font-size:.6rem;color:var(--gray);margin-bottom:14px;}
.receipt-row{display:flex;justify-content:space-between;padding:6px 0;}
.receipt-row:not(:last-child){border-bottom:1px solid rgba(255,255,255,.05);}
.rk{font-size:.68rem;color:rgba(255,255,255,.38);}
.rv{font-size:.76rem;font-weight:700;}
.rv.green{color:#4ade80;}
.receipt-amount{background:rgba(26,86,255,.12);border-radius:10px;padding:11px;text-align:center;margin:12px 0;}
.ra-label{font-size:.6rem;color:var(--gray);margin-bottom:3px;}
.ra-val{font-family:'Syne',sans-serif;font-size:1.5rem;font-weight:900;background:linear-gradient(90deg,var(--accent),var(--blue));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.receipt-status{text-align:center;font-size:.68rem;color:#4ade80;font-weight:700;letter-spacing:1px;margin-top:9px;}
.modal-actions{display:flex;gap:9px;}
.modal-btn{flex:1;padding:12px;border-radius:10px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;font-family:'DM Sans',sans-serif;}
.modal-btn.share{background:var(--green);color:#fff;}
.modal-btn.close-btn{background:rgba(255,255,255,.07);color:#fff;border:1px solid rgba(255,255,255,.12);}
/* OWNER */
.login-screen{padding:40px 5%;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:80vh;}
.login-icon{width:68px;height:68px;border-radius:18px;background:linear-gradient(135deg,var(--purple),var(--blue));display:flex;align-items:center;justify-content:center;font-size:1.7rem;margin:0 auto 18px;box-shadow:0 12px 36px rgba(124,58,237,.4);}
.login-title{font-family:'Syne',sans-serif;font-size:1.25rem;font-weight:900;text-align:center;margin-bottom:5px;}
.login-sub{font-size:.78rem;color:var(--gray);text-align:center;margin-bottom:26px;}
.login-form{width:100%;}
.login-btn{width:100%;background:linear-gradient(135deg,var(--purple),var(--blue));color:#fff;padding:13px;border-radius:12px;font-weight:800;font-size:.9rem;font-family:'Syne',sans-serif;border:none;cursor:pointer;box-shadow:0 8px 24px rgba(124,58,237,.4);margin-top:4px;}
.login-btn:active{transform:scale(.98);}
.login-error{background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.3);border-radius:9px;padding:9px 13px;font-size:.76rem;color:#fca5a5;margin-top:9px;display:none;}
.owner-header{background:linear-gradient(135deg,rgba(124,58,237,.15),rgba(26,86,255,.08));border-bottom:1px solid rgba(124,58,237,.2);padding:16px 5%;display:flex;align-items:center;justify-content:space-between;}
.owner-info h3{font-family:'Syne',sans-serif;font-size:.92rem;font-weight:800;}
.owner-info p{font-size:.66rem;color:rgba(167,139,250,.8);margin-top:2px;}
.logout-btn{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.25);color:#fca5a5;padding:6px 13px;border-radius:8px;font-size:.7rem;font-weight:700;cursor:pointer;font-family:'DM Sans',sans-serif;}
.owner-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:9px;margin-bottom:16px;}
.owner-stat{background:var(--glass);border:1px solid var(--gborder);border-radius:12px;padding:14px;text-align:center;}
.os-val{font-family:'Syne',sans-serif;font-size:1.3rem;font-weight:900;margin-bottom:3px;}
.os-val.green{color:#4ade80;} .os-val.blue{color:var(--accent);} .os-val.gold{color:var(--gold);} .os-val.purple{color:#a78bfa;}
.os-label{font-size:.61rem;color:var(--gray);text-transform:uppercase;letter-spacing:.5px;}
.filter-tabs{display:flex;gap:7px;margin-bottom:13px;overflow-x:auto;padding-bottom:3px;}
.filter-tabs::-webkit-scrollbar{display:none;}
.ftab{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:5px 13px;font-size:.7rem;font-weight:600;cursor:pointer;white-space:nowrap;font-family:'DM Sans',sans-serif;color:rgba(255,255,255,.5);}
.ftab.active{background:var(--blue);border-color:var(--blue);color:#fff;}
.all-receipts-wrap{display:flex;flex-direction:column;gap:9px;}
.no-data{text-align:center;padding:28px;color:var(--gray);font-size:.83rem;}
.no-data i{font-size:1.8rem;display:block;margin-bottom:9px;opacity:.35;}
.receipt-list-item{background:var(--glass);border:1px solid var(--gborder);border-radius:12px;padding:14px;display:flex;align-items:center;gap:12px;cursor:pointer;}
.receipt-list-item:active{transform:scale(.98);background:rgba(26,86,255,.07);}
.rli-icon{width:38px;height:38px;border-radius:9px;background:rgba(26,86,255,.15);display:flex;align-items:center;justify-content:center;font-size:.95rem;flex-shrink:0;}
.rli-body{flex:1;min-width:0;}
.rli-no{font-family:'Syne',sans-serif;font-size:.78rem;font-weight:700;}
.rli-name{font-size:.68rem;color:var(--gray);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.rli-right{text-align:right;flex-shrink:0;}
.rli-amt{font-family:'Syne',sans-serif;font-size:.88rem;font-weight:800;color:#4ade80;}
.rli-date{font-size:.6rem;color:var(--gray);margin-top:2px;}
/* STEPS */
.steps{display:flex;flex-direction:column;gap:0;margin-top:4px;}
.step{display:flex;gap:12px;padding-bottom:16px;position:relative;}
.step:not(:last-child)::after{content:'';position:absolute;left:17px;top:36px;width:2px;bottom:0;background:rgba(26,86,255,.18);}
.step-num{width:34px;height:34px;border-radius:50%;flex-shrink:0;background:var(--blue);display:flex;align-items:center;justify-content:center;font-family:'Syne',sans-serif;font-weight:800;font-size:.78rem;box-shadow:0 4px 14px rgba(26,86,255,.4);z-index:1;}
.step-body{padding-top:4px;}
.step-body h4{font-family:'Syne',sans-serif;font-size:.86rem;font-weight:700;margin-bottom:2px;}
.step-body p{font-size:.75rem;color:var(--gray);line-height:1.55;}
/* BOTTOM NAV */
.bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:200;background:rgba(5,11,24,.98);backdrop-filter:blur(24px);border-top:1px solid rgba(255,255,255,.07);display:grid;grid-template-columns:repeat(5,1fr);padding-bottom:env(safe-area-inset-bottom,0px);}
.nav-item{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:9px 2px;cursor:pointer;font-size:.5rem;color:rgba(255,255,255,.28);gap:3px;letter-spacing:.2px;border:none;background:none;font-family:'DM Sans',sans-serif;font-weight:500;position:relative;}
.nav-item::after{content:'';position:absolute;top:0;left:15%;right:15%;height:2px;border-radius:0 0 2px 2px;background:var(--blue);opacity:0;transition:opacity .2s;}
.nav-item.active{color:var(--blue);}
.nav-item.active::after{opacity:1;}
.nav-item i{font-size:.95rem;}
.bottom-nav-spacer{height:72px;}
.fl-wa{position:fixed;bottom:82px;right:16px;z-index:150;width:46px;height:46px;background:var(--green);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;box-shadow:0 4px 20px rgba(37,211,102,.45);}
</style>
</head>
