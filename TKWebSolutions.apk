<div class="bottom-nav">
  <button class="nav-item active" id="nav-home" onclick="showPage('home')"><i class="fas fa-home"></i>Home</button>
  <button class="nav-item" id="nav-services" onclick="showPage('services')"><i class="fas fa-th-large"></i>Services</button>
  <button class="nav-item" id="nav-portfolio" onclick="showPage('portfolio')"><i class="fas fa-images"></i>Work</button>
  <button class="nav-item" id="nav-founder" onclick="showPage('founder')"><i class="fas fa-user"></i>Founder</button>
  <button class="nav-item" id="nav-payment" onclick="showPage('payment')"><i class="fas fa-credit-card"></i>Pay</button>
</div>

<script>
const APPS_SCRIPT_URL='https://script.google.com/macros/s/AKfycbyH2vIubLbmaksKz0avNLuWw9RX-SwZmE-LHNk2cRMVZ5YZ7wpmW7fz7yNrEIQdXEU/exec';
const WA_NUM='919079368240';
const OWNER_USER='tarun';
const OWNER_PASS='tk@2024';

function showPage(p){
  if(p==='owner'){
    document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));
    document.getElementById('page-owner').classList.add('active');
    window.scrollTo(0,0);
    if(sessionStorage.getItem('tk_owner')==='1'){
      document.getElementById('ownerLogin').style.display='none';
      document.getElementById('ownerDash').style.display='block';
      loadOwnerDash();
    } else {
      document.getElementById('ownerLogin').style.display='flex';
      document.getElementById('ownerDash').style.display='none';
    }
    return;
  }
  document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(x=>x.classList.remove('active'));
  const el=document.getElementById('page-'+p);
  if(el){el.classList.add('active');window.scrollTo(0,0);}
  const nb=document.getElementById('nav-'+p);
  if(nb)nb.classList.add('active');
}

function switchPayMethod(m,el){
  document.querySelectorAll('.pay-method').forEach(x=>x.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('upi-section').style.display=m==='upi'?'':'none';
  document.getElementById('bank-section').style.display=m==='bank'?'':'none';
}

function setAmt(a,btn){
  document.getElementById('payAmt').value=a;
  document.querySelectorAll('.amt-btn').forEach(b=>b.classList.remove('selected'));
  btn.classList.add('selected');
  updatePayBtn();
}

function updatePayBtn(){
  const a=document.getElementById('payAmt').value;
  const btn=document.getElementById('payNowBtn');
  if(btn)btn.innerHTML='<i class="fas fa-bolt"></i> Pay \u20B9'+(a?Number(a).toLocaleString('en-IN'):'---');
}

function genReceiptNo(){
  const now=new Date(new Date().toLocaleString('en-US',{timeZone:'Asia/Kolkata'}));
  return 'TK-WEB-'+String(now.getDate()).padStart(2,'0')+String(now.getMonth()+1).padStart(2,'0')+String(now.getFullYear()).slice(-2)+'-'+Math.floor(1000+Math.random()*9000);
}

function getIST(){
  return new Date().toLocaleString('en-IN',{timeZone:'Asia/Kolkata',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit',hour12:true});
}

function doPayment(){
  const amt=document.getElementById('payAmt').value;
  const name=document.getElementById('payName').value.trim();
  const phone=document.getElementById('payPhone').value.trim();
  const service=document.getElementById('payService').value;
  const upiRef=document.getElementById('upiRef').value.trim();
  if(!amt){alert('Pehle amount select ya enter karo!');return;}
  if(!name){alert('Apna naam daalna zaroori hai!');return;}
  window.location.href='upi://pay?pa=tarun.8240@ptyes&pn=TK+Web+Solutions&am='+amt+'&tn='+encodeURIComponent(service)+'&cu=INR';
  const data={receiptNo:genReceiptNo(),datetime:getIST(),name,phone,amount:amt,purpose:service,service,upiRef};
  setTimeout(()=>{saveLocal(data);showReceiptModal(data);sendOwnerAlert(data);saveToSheet(data);},1800);
}

function notifyPayment(){
  const name=document.getElementById('payName').value.trim()||'Customer';
  const amt=document.getElementById('payAmt').value||'?';
  const service=document.getElementById('payService').value;
  const ref=document.getElementById('upiRef').value.trim();
  const msg='\u2705 *Payment Confirm!*\n\n\ud83d\udc64 Naam: '+name+'\n\ud83d\udcb0 Amount: \u20b9'+amt+'\n\ud83c\udf10 Service: '+service+(ref?'\n\ud83d\udd16 UPI Ref: '+ref:'')+'\n\n\ud83d\udcf2 Receipt chahiye!';
  window.open('https://wa.me/'+WA_NUM+'?text='+encodeURIComponent(msg),'_blank');
}

function searchReceipt(){
  const q=document.getElementById('searchInp').value.trim();
  if(!q){alert('Receipt number ya phone number daalo!');return;}
  const btn=document.querySelector('[onclick="searchReceipt()"]');
  if(btn){btn.textContent='...';btn.disabled=true;}
  const localData=JSON.parse(localStorage.getItem('tk_receipts')||'[]');
  const found=localData.find(r=>r.receiptNo===q||r.phone===q||r.phone.replace(/\D/g,'').includes(q.replace(/\D/g,'')));
  if(found){if(btn){btn.textContent='Dhundho';btn.disabled=false;}showReceiptModal(found);return;}
  fetch(APPS_SCRIPT_URL+'?q='+encodeURIComponent(q))
    .then(r=>r.json()).then(rows=>{
      if(btn){btn.textContent='Dhundho';btn.disabled=false;}
      if(rows&&rows.length>0){
        const row=rows[0];
        const data={receiptNo:row[0],datetime:row[1],name:row[2],phone:row[3],amount:(row[4]||'').toString().replace('Rs.',''),purpose:row[5]||'Payment',service:row[7]||'N/A',upiRef:row[10]||'N/A'};
        showReceiptModal(data);
      } else {
        document.getElementById('searchResult').innerHTML='<div style="text-align:center;padding:14px;color:var(--gray);font-size:.8rem;">\ud83d\ude15 Koi record nahi mila. Sahi receipt no. ya phone try karo.</div>';
      }
    }).catch(()=>{
      if(btn){btn.textContent='Dhundho';btn.disabled=false;}
      document.getElementById('searchResult').innerHTML='<div style="text-align:center;padding:14px;color:#fca5a5;font-size:.8rem;">\u26a0\ufe0f Network error. WhatsApp pe check karo.</div>';
    });
}

let _curReceipt=null;

function showReceiptModal(data){
  _curReceipt=data;
  const amtFmt=Number(data.amount||0).toLocaleString('en-IN');
  document.getElementById('receiptContent').innerHTML=`
    <div class="receipt-logo"><span>TK</span> Web Solutions</div>
    <div class="receipt-no">\ud83d\udccb ${data.receiptNo||'N/A'} &nbsp;|&nbsp; ${data.datetime||''}</div>
    <div class="receipt-amount"><div class="ra-label">Payment Amount</div><div class="ra-val">\u20b9${amtFmt}</div></div>
    <div class="receipt-row"><span class="rk">\ud83d\udc64 Client Naam</span><span class="rv">${data.name||'N/A'}</span></div>
    <div class="receipt-row"><span class="rk">\ud83d\udcf1 Phone</span><span class="rv">${data.phone||'N/A'}</span></div>
    <div class="receipt-row"><span class="rk">\ud83c\udf10 Service</span><span class="rv">${data.service||data.purpose||'N/A'}</span></div>
    <div class="receipt-row"><span class="rk">\ud83d\udd16 UPI Ref</span><span class="rv">${data.upiRef||'N/A'}</span></div>
    <div class="receipt-row"><span class="rk">\ud83d\udccd Location</span><span class="rv">Bharatpur, Rajasthan</span></div>
    <div class="receipt-status">\u2705 PAYMENT CONFIRMED</div>`;
  document.getElementById('receiptModal').classList.add('open');
}

function closeReceiptModal(){document.getElementById('receiptModal').classList.remove('open');}
function closeModalBg(e){if(e.target===document.getElementById('receiptModal'))closeReceiptModal();}

function shareReceipt(){
  if(!_curReceipt)return;
  const d=_curReceipt;
  const msg='\ud83e\uddfb *TK Web Solutions - Payment Receipt*\n\n\ud83d\udccb Receipt No: *'+d.receiptNo+'*\n\ud83d\udcc5 Date: '+d.datetime+'\n\ud83d\udc64 Naam: '+d.name+'\n\ud83d\udcf1 Phone: '+(d.phone||'N/A')+'\n\ud83d\udcb0 Amount: *\u20b9'+Number(d.amount||0).toLocaleString('en-IN')+'*\n\ud83c\udf10 Service: '+d.service+'\n\u2705 Status: Confirmed\n\n\ud83c\udf10 tkwebsolutions.in';
  window.open('https://wa.me/?text='+encodeURIComponent(msg),'_blank');
}

function saveLocal(data){
  try{const arr=JSON.parse(localStorage.getItem('tk_receipts')||'[]');arr.unshift(data);localStorage.setItem('tk_receipts',JSON.stringify(arr.slice(0,100)));}catch(e){}
}

function saveToSheet(data){
  try{fetch(APPS_SCRIPT_URL,{method:'POST',mode:'no-cors',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:'save',...data})});}catch(e){}
}

function sendOwnerAlert(data){
  const msg='\ud83d\udcb0 *NEW PAYMENT - TK Web Solutions*\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\ud83e\uddfb '+data.receiptNo+'\n\ud83d\udc64 '+data.name+'\n\ud83d\udcf1 '+(data.phone||'N/A')+'\n\ud83d\udcb0 *\u20b9'+Number(data.amount||0).toLocaleString('en-IN')+'*\n\ud83c\udf10 '+data.service+'\n\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\u2501\n\ud83c\udf10 tkwebsolutions.in';
  window.open('https://wa.me/'+WA_NUM+'?text='+encodeURIComponent(msg),'_blank');
}

function copyUPI(){
  navigator.clipboard.writeText('tarun.8240@ptyes').then(()=>{
    const btn=document.querySelector('[onclick="copyUPI()"]');
    if(btn){btn.textContent='\u2705 Copied!';setTimeout(()=>btn.textContent='\ud83d\udccb Copy',2000);}
  });
}

function copyText(text,btn){
  navigator.clipboard.writeText(text).then(()=>{btn.textContent='\u2705';setTimeout(()=>btn.textContent='\ud83d\udccb',2000);});
}

function doLogin(){
  const u=document.getElementById('loginUser').value.trim();
  const p=document.getElementById('loginPass').value;
  if(u===OWNER_USER&&p===OWNER_PASS){
    document.getElementById('ownerLogin').style.display='none';
    document.getElementById('ownerDash').style.display='block';
    sessionStorage.setItem('tk_owner','1');
    loadOwnerDash();
  } else {
    const err=document.getElementById('loginErr');
    err.style.display='block';
    setTimeout(()=>err.style.display='none',3000);
  }
}

function doLogout(){
  sessionStorage.removeItem('tk_owner');
  document.getElementById('ownerLogin').style.display='flex';
  document.getElementById('ownerDash').style.display='none';
  document.getElementById('loginUser').value='';
  document.getElementById('loginPass').value='';
  showPage('home');
}

let _allReceipts=[];

function loadOwnerDash(){
  try{_allReceipts=JSON.parse(localStorage.getItem('tk_receipts')||'[]');}catch(e){_allReceipts=[];}
  renderOwnerStats(_allReceipts);
  renderOwnerList(_allReceipts);
  try{
    fetch(APPS_SCRIPT_URL+'?action=all').then(r=>r.json()).then(rows=>{
      if(Array.isArray(rows)&&rows.length>0){
        const sheetData=rows.map(row=>({receiptNo:row[0],datetime:row[1],name:row[2],phone:row[3],amount:(row[4]||'0').toString().replace(/[^\d.]/g,''),service:row[7]||row[5]||'N/A',purpose:row[5]||'',upiRef:row[10]||'N/A'})).filter(r=>r.receiptNo);
        const map=new Map();
        [..._allReceipts,...sheetData].forEach(r=>{if(r.receiptNo)map.set(r.receiptNo,r);});
        _allReceipts=Array.from(map.values());
        renderOwnerStats(_allReceipts);
        renderOwnerList(_allReceipts);
      }
    }).catch(()=>{});
  }catch(e){}
}

function renderOwnerStats(data){
  const total=data.reduce((s,r)=>s+(Number(r.amount)||0),0);
  const now=new Date();
  const mTotal=data.filter(r=>{try{const d=new Date(r.datetime);return d.getMonth()===now.getMonth()&&d.getFullYear()===now.getFullYear();}catch(e){return false;}}).reduce((s,r)=>s+(Number(r.amount)||0),0);
  const avg=data.length>0?Math.round(total/data.length):0;
  document.getElementById('osTotalAmt').textContent='\u20b9'+total.toLocaleString('en-IN');
  document.getElementById('osTotalCount').textContent=data.length;
  document.getElementById('osThisMonth').textContent='\u20b9'+mTotal.toLocaleString('en-IN');
  document.getElementById('osAvg').textContent='\u20b9'+avg.toLocaleString('en-IN');
}

function renderOwnerList(data){
  const el=document.getElementById('ownerReceiptList');
  if(!data||data.length===0){el.innerHTML='<div class="no-data"><i class="fas fa-receipt"></i>Koi payments nahi mili abhi.</div>';return;}
  el.innerHTML=data.map(r=>{
    const safeData=JSON.stringify(r).replace(/'/g,"\\'").replace(/"/g,'&quot;');
    return `<div class="receipt-list-item" onclick='showReceiptModal(${JSON.stringify(r)})'>
      <div class="rli-icon">\ud83e\uddfb</div>
      <div class="rli-body"><div class="rli-no">${r.receiptNo||'N/A'}</div><div class="rli-name">${r.name||'N/A'} \u00b7 ${r.service||'N/A'}</div></div>
      <div class="rli-right"><div class="rli-amt">\u20b9${Number(r.amount||0).toLocaleString('en-IN')}</div><div class="rli-date">${(r.datetime||'').split(',')[0]||''}</div></div>
    </div>`;
  }).join('');
}

function filterOwner(kw,btn){
  document.querySelectorAll('.ftab').forEach(t=>t.classList.remove('active'));
  btn.classList.add('active');
  if(kw==='all'){renderOwnerList(_allReceipts);return;}
  renderOwnerList(_allReceipts.filter(r=>(r.service||'').toLowerCase().includes(kw.toLowerCase())||(r.purpose||'').toLowerCase().includes(kw.toLowerCase())));
}

if(sessionStorage.getItem('tk_owner')==='1'){
  document.getElementById('ownerLogin').style.display='none';
  document.getElementById('ownerDash').style.display='block';
}
</script>
</body>
</html>
